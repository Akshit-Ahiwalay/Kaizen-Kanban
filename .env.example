# Empty placeholders select the in-memory demo (no Supabase client).
# For persistence, configure only a separate local/development project.
# VITE_* values are exposed to the browser. Never use service-role keys,
# database passwords, OAuth client secrets, or other secrets here.
# Example URL shape: http://127.0.0.1:54321
# Set the development publishable/anon client key only in ignored .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
